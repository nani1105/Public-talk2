ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Vercel Blob (optional locally — run `vercel env pull .env.local`)
# BLOB_STORE_ID=          # set by Vercel when Blob store is linked (OIDC)
# BLOB_READ_WRITE_TOKEN=    # only needed for local dev without OIDC, or external scripts
